+#if defined(TARGET_HAIKU)
+/*
+ * Haiku names the interface of every route. Routes through the VPN belong
+ * on the tunnel; only routes via the pre-existing default gateway (like the
+ * host route to the server for redirect-gateway) stay on the interface that
+ * reaches that gateway.
+ */
+static const char *
+haiku_route_iface(in_addr_t gateway, const struct tuntap *tt,
+                  const struct route_gateway_info *rgi)
+{
+    if (rgi && (rgi->flags & RGI_IFACE_DEFINED)
+        && (rgi->flags & RGI_ADDR_DEFINED) && gateway == rgi->gateway.addr)
+    {
+        return rgi->iface;
+    }
+    if (tt && tt->actual_name)
+    {
+        return tt->actual_name;
+    }
+    return rgi && (rgi->flags & RGI_IFACE_DEFINED) ? rgi->iface : NULL;
+}
+#endif
