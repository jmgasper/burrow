resource app_signature "application/x-vnd.Burrow";
resource app_flags B_SINGLE_LAUNCH;
resource vector_icon {
    import "branding/burrow-icon.hvif"
};
resource app_version {
    major = 0,
    middle = 1,
    minor = 0,
    variety = B_APPV_ALPHA,
    internal = 0,
    short_info = "Burrow 0.1.0 alpha — VPN client",
    long_info = "A native Haiku VPN client for AWS Client VPN and OpenVPN servers, with AWS single sign-on."
};
resource file_types message {
    "types" = "application/x-openvpn-profile",
    // Haiku identifies .ovpn files by content as text/plain; this puts Burrow
    // in Tracker's "Open with" for them.
    "types" = "text/plain"
};
